Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS + www (uncomment once SSL is active)
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.primecarehealthsolutions.online%{REQUEST_URI} [L,R=301]

  # Block direct access to private folders only (not /mail)
  RewriteRule ^(data|includes)(/|$) - [F,L]

  # Mail portal: /mail -> /mail/index.php
  RewriteRule ^mail/?$ mail/index.php [L]

  # Clean URLs: /about -> about.php (single-word pages only)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|md)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
